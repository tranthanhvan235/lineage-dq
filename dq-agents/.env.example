# SINH TU config/dq-config.yaml - DUNG SUA TAY.
# Sua ban khai roi chay: python3 scripts/sync_config.py --write
#
# Chep thanh dq-agents/.env roi dien LLM_API_KEY. File .env khong vao git.

# ── Danh tinh pipeline (dat theo tung lan chay) ───────────────
# Cot phan vung cua bang dau ra. Moi pipeline ghi de trong SparkApplication cua no (date_hour,
# event_date...); gia tri o day chi la mac dinh.
DQ_PARTITION_COLUMN=date_time

# ── Cong chat luong va nguong ─────────────────────────────────
# 0.9 chu khong phai 0.8: diem chat luong du lieu binh thuong rat cao, 0.9 da la mot phan muoi
# du lieu hong - o quy mo big data do la con so lon.
DQ_QUALITY_FAIL_THRESHOLD=0.9
DQ_QUALITY_WARNING_THRESHOLD=0.95

# ── Tien trinh agent va dich vu HTTP ──────────────────────────
DQ_AGENT_CHECKPOINTS=true
DQ_AGENT_DIR=/opt/dq-agents
DQ_AGENT_TIMEOUT_SEC=600
DQ_LIVE_MAX_QUERIES=5
DQ_LIVE_MAX_ROWS=50
DQ_LIVE_STAGE_VIEW=dq_stage

# ── Mo hinh ngon ngu ──────────────────────────────────────────
LLM_API_KEY=
# trong cum: https://llm-gateway.example.com/v1
LLM_BASE_URL=https://api.groq.com/openai/v1
# 60 chu khong phai 20. Gen Rules phai di het MOI checkpoint va duyet SAU ho loi o tung
# checkpoint, nen chi phi vong lap ti le voi so checkpoint chu khong co dinh. Da do that tren
# pipeline 9 checkpoint: 20 vong khong du de phu het, 60 vong van cham tran khi agent phai sua
# lai sau khi bi cong do phu tu choi. Pipeline mot vai checkpoint thi 60 la du rong.
LLM_MAX_ITERATIONS=60
LLM_MAX_RETRIES=2
# trong cum: Qwen/Qwen3.6-35B-A3B-FP8
LLM_MODEL=llama-3.3-70b-versatile
# Khong dat thi mot lan goi LLM treo se giu tien trinh mai mai. Duong HTTP co runner canh
# deadline nen khong lo ra, nhung chay agent doc lap thi treo vo han - da dinh that, mot lan
# 57 phut khong nhuc nhich trong khi endpoint hoan toan khoe. Ten khong co tien to DQ_:
# runner.py dat dung hai ten nay khi cap ngan sach cho tung phien. Doc ten khac di la ngan
# sach khong bao gio toi agent.
LLM_REQUEST_TIMEOUT_SEC=180

# ── Sinh rule ─────────────────────────────────────────────────
# So lan Orchestrator duoc goi lai Gen Rules sau khi Verify tu choi. Tung la 3, do tren
# pipeline 4 checkpoint. Het 3 luot tren cell_capacity_daily (8 checkpoint, 287 cot) hai lan
# lien 22/09/2026, va ca hai lan deu DANG HOI TU: gop y cua Verify moi luot moi khac va moi
# luot mot it hon - luot cuoi chi con thieu rule cho DUNG MOT cot (wd_baseline.cell_name).
# Dung o 3 la dung giua duong roi bo het cong sinh, giu lai bo rule cu dang co 5 rule sai.
# Khong phai nguong an toan: het luot thi bo rule moi bi huy, bo cu van nguyen, nen gia cua
# mot luot nua chi la thoi gian.
DQ_MAX_REGEN_ATTEMPTS=5
DQ_VOLUME_ANOMALY_THRESHOLD_PCT=30
DQ_VOLUME_HISTORY_WINDOW=7

# ── Kho luu tru va lineage ────────────────────────────────────
DQ_LINEAGE_MARQUEZ_FALLBACK=false
DQ_LINEAGE_POLL_RETRIES=8
DQ_LINEAGE_POLL_SLEEP_MS=1000
DQ_LINEAGE_RAW_FILE=/tmp/openlineage-events.ndjson
DQ_LINEAGE_RESHAPE=false
DQ_LINEAGE_STORE_ENABLED=true
DQ_ROOT=/dq
DQ_WAREHOUSE_CATALOG=dq_iceberg
DQ_WAREHOUSE_ENABLED=true
HDFS_DATANODE_SELECTOR=app=hdfs-datanode
HDFS_NAMESPACE=hdfs
HDFS_WEBHDFS_USER=root
# Chi la duong lui cho lineage. Nguon chinh: /dq/lineage/{key}/latest.json (su kien goc).
# trong cum: http://marquez-api.marquez.svc.cluster.local:5000
MARQUEZ_URL=http://localhost:30500
OPENLINEAGE_DATASET_NAMESPACE=hdfs://namenode:9000
OPENLINEAGE_NAMESPACE=voice-call-pipeline
# trong cum: http://namenode:9870
WEBHDFS_URL=http://localhost:9870

