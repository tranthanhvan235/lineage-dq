        varchar dq_key
        varchar dataset_name
        varchar verified_at
        varchar overall_verdict
        varchar stage PK
        varchar stage_verdict
        varchar notes
    }
    dq_analysis {
        varchar analysis_id PK
        varchar dq_key
        varchar report_run_id
        varchar analysis_type
        varchar content
        varchar saved_at
    }
