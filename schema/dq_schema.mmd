        varchar created_at
        varchar stage PK
        varchar kind
        varchar observed_expr
        varchar expected
        varchar observed_unit
    }
    dq_lineage_state {
        varchar dq_key PK
        varchar dataset_name
        varchar lineage_hash
        varchar generation_run_id
        varchar updated_at
    }
    dq_report_history {
        varchar run_id PK
        varchar executed_at
        varchar dq_key
        varchar dataset_name
        varchar status
